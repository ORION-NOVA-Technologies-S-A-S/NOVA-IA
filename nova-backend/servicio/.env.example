# Copia a .env (NUNCA lo subas a un repositorio). Las claves secretas viven solo en el servidor.
DATABASE_URL=postgres://servicio_login:<CLAVE>@<HOST>:5432/nova
JWT_SECRET=<el mismo secreto de postgrest.conf>
PUBLIC_URL=https://<tu-dominio>

# Pasarela (Wompi). Llaves del panel de Wompi. En pruebas usa las de "sandbox".
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx

# Mensajes de recuperación de contraseña
WHATSAPP_PHONE_ID=<id del número en Meta WhatsApp Cloud API>
WHATSAPP_TOKEN=<token permanente>
WHATSAPP_TEMPLATE=codigo_recuperacion          # plantilla de autenticación aprobada por Meta
SMS_PROVIDER_URL=<API de tu proveedor de SMS>
SMS_PROVIDER_TOKEN=<token>

# La cuenta de Nova que recibe el dinero (Nequi/banco) se configura en el panel de la pasarela como cuenta de liquidación.
# No va en el código ni en este archivo.
